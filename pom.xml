<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.niimbot</groupId>
    <artifactId>niimbot-java</artifactId>
    <version>1.0.0</version>
    <name>niimbot-java</name>
    <description>Java driver for Niimbot label printers over BLE (port of niimbot-web-bluetooth)</description>
    <url>https://github.com/thiagodemoura/niimbot-java</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/thiagodemoura/niimbot-java</url>
        <connection>scm:git:https://github.com/thiagodemoura/niimbot-java.git</connection>
    </scm>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <simplejavable.version>1.2.0</simplejavable.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- BLE for Windows / macOS / Linux, native libs bundled. Only needed by dev.niimbot.ble. -->
        <dependency>
            <groupId>org.simpleble</groupId>
            <artifactId>simplejavable</artifactId>
            <version>${simplejavable.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- mvn package → target/niimbot-java-1.0.0-all.jar, runnable: java -jar … print label.png -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <!-- keep simplejavable in the published pom: the plain jar needs it -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>dev.niimbot.cli.NiimbotCli</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- mvn deploy → GitHub Packages; needs a <server id="github"> with a write:packages token in settings.xml -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/thiagodemoura/niimbot-java</url>
        </repository>
    </distributionManagement>
</project>
